digraph schema {
graph [rankdir=LR, bgcolor=white, nodesep=0.5, ranksep=1.1, fontname="Helvetica", pad=0.3, splines=true];
node [shape=plaintext, fontname="Helvetica"]; edge [color="#1c5cab", arrowhead=normal, arrowsize=0.7];
users [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#888888"><tr><td colspan="3" bgcolor="#1c5cab"><font color="white"><b>users</b></font></td></tr><tr><td port="user_id" align="left" bgcolor="#fff3d6"><b>user_id</b></td><td align="left"><font color="#555555">SERIAL</font></td><td align="left"><font color="#9a6400">PK</font></td></tr><tr><td port="institution_id" align="left" bgcolor="white">institution_id</td><td align="left"><font color="#555555">VARCHAR(20)</font></td><td align="left"><font color="#9a6400">UQ</font></td></tr><tr><td port="full_name" align="left" bgcolor="white">full_name</td><td align="left"><font color="#555555">VARCHAR(100)</font></td><td align="left"> </td></tr><tr><td port="email" align="left" bgcolor="white">email</td><td align="left"><font color="#555555">VARCHAR(120)</font></td><td align="left"><font color="#9a6400">UQ</font></td></tr><tr><td port="password_hash" align="left" bgcolor="white">password_hash</td><td align="left"><font color="#555555">VARCHAR(100)</font></td><td align="left"> </td></tr><tr><td port="role" align="left" bgcolor="white">role</td><td align="left"><font color="#555555">VARCHAR(12)</font></td><td align="left"><font color="#9a6400">CHK</font></td></tr><tr><td port="department" align="left" bgcolor="white">department</td><td align="left"><font color="#555555">VARCHAR(60)</font></td><td align="left"> </td></tr><tr><td port="is_active" align="left" bgcolor="white">is_active</td><td align="left"><font color="#555555">BOOLEAN</font></td><td align="left"> </td></tr><tr><td port="created_at" align="left" bgcolor="white">created_at</td><td align="left"><font color="#555555">TIMESTAMPTZ</font></td><td align="left"> </td></tr></table>>];
user_phones [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#888888"><tr><td colspan="3" bgcolor="#5b48c9"><font color="white"><b>user_phones</b></font></td></tr><tr><td port="user_id" align="left" bgcolor="#fff3d6"><b>user_id</b></td><td align="left"><font color="#555555">INT</font></td><td align="left"><font color="#9a6400">PK, FK</font></td></tr><tr><td port="phone_no" align="left" bgcolor="#fff3d6"><b>phone_no</b></td><td align="left"><font color="#555555">VARCHAR(15)</font></td><td align="left"><font color="#9a6400">PK</font></td></tr><tr><td port="phone_type" align="left" bgcolor="white">phone_type</td><td align="left"><font color="#555555">VARCHAR(10)</font></td><td align="left"><font color="#9a6400">CHK</font></td></tr></table>>];
labs [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#888888"><tr><td colspan="3" bgcolor="#1c5cab"><font color="white"><b>labs</b></font></td></tr><tr><td port="lab_id" align="left" bgcolor="#fff3d6"><b>lab_id</b></td><td align="left"><font color="#555555">SERIAL</font></td><td align="left"><font color="#9a6400">PK</font></td></tr><tr><td port="lab_code" align="left" bgcolor="white">lab_code</td><td align="left"><font color="#555555">VARCHAR(12)</font></td><td align="left"><font color="#9a6400">UQ</font></td></tr><tr><td port="lab_name" align="left" bgcolor="white">lab_name</td><td align="left"><font color="#555555">VARCHAR(80)</font></td><td align="left"> </td></tr><tr><td port="building" align="left" bgcolor="white">building</td><td align="left"><font color="#555555">VARCHAR(40)</font></td><td align="left"> </td></tr><tr><td port="floor_no" align="left" bgcolor="white">floor_no</td><td align="left"><font color="#555555">SMALLINT</font></td><td align="left"> </td></tr><tr><td port="room_no" align="left" bgcolor="white">room_no</td><td align="left"><font color="#555555">VARCHAR(10)</font></td><td align="left"> </td></tr><tr><td port="capacity" align="left" bgcolor="white">capacity</td><td align="left"><font color="#555555">INT</font></td><td align="left"><font color="#9a6400">CHK</font></td></tr><tr><td port="incharge_id" align="left" bgcolor="white">incharge_id</td><td align="left"><font color="#555555">INT</font></td><td align="left"><font color="#9a6400">FK</font></td></tr></table>>];
equipment_categories [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#888888"><tr><td colspan="3" bgcolor="#1c5cab"><font color="white"><b>equipment_categories</b></font></td></tr><tr><td port="category_id" align="left" bgcolor="#fff3d6"><b>category_id</b></td><td align="left"><font color="#555555">SERIAL</font></td><td align="left"><font color="#9a6400">PK</font></td></tr><tr><td port="category_name" align="left" bgcolor="white">category_name</td><td align="left"><font color="#555555">VARCHAR(60)</font></td><td align="left"><font color="#9a6400">UQ</font></td></tr><tr><td port="parent_id" align="left" bgcolor="white">parent_id</td><td align="left"><font color="#555555">INT</font></td><td align="left"><font color="#9a6400">FK</font></td></tr><tr><td port="expected_life_years" align="left" bgcolor="white">expected_life_years</td><td align="left"><font color="#555555">NUMERIC(4,1)</font></td><td align="left"> </td></tr><tr><td port="description" align="left" bgcolor="white">description</td><td align="left"><font color="#555555">TEXT</font></td><td align="left"> </td></tr></table>>];
equipment [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#888888"><tr><td colspan="3" bgcolor="#1c5cab"><font color="white"><b>equipment</b></font></td></tr><tr><td port="equipment_id" align="left" bgcolor="#fff3d6"><b>equipment_id</b></td><td align="left"><font color="#555555">SERIAL</font></td><td align="left"><font color="#9a6400">PK</font></td></tr><tr><td port="asset_tag" align="left" bgcolor="white">asset_tag</td><td align="left"><font color="#555555">VARCHAR(20)</font></td><td align="left"><font color="#9a6400">UQ</font></td></tr><tr><td port="equipment_name" align="left" bgcolor="white">equipment_name</td><td align="left"><font color="#555555">VARCHAR(100)</font></td><td align="left"> </td></tr><tr><td port="category_id" align="left" bgcolor="white">category_id</td><td align="left"><font color="#555555">INT</font></td><td align="left"><font color="#9a6400">FK</font></td></tr><tr><td port="lab_id" align="left" bgcolor="white">lab_id</td><td align="left"><font color="#555555">INT</font></td><td align="left"><font color="#9a6400">FK</font></td></tr><tr><td port="manufacturer" align="left" bgcolor="white">manufacturer</td><td align="left"><font color="#555555">VARCHAR(60)</font></td><td align="left"> </td></tr><tr><td port="model_no" align="left" bgcolor="white">model_no</td><td align="left"><font color="#555555">VARCHAR(60)</font></td><td align="left"> </td></tr><tr><td port="serial_no" align="left" bgcolor="white">serial_no</td><td align="left"><font color="#555555">VARCHAR(60)</font></td><td align="left"><font color="#9a6400">UQ</font></td></tr><tr><td port="purchase_date" align="left" bgcolor="white">purchase_date</td><td align="left"><font color="#555555">DATE</font></td><td align="left"> </td></tr><tr><td port="purchase_cost" align="left" bgcolor="white">purchase_cost</td><td align="left"><font color="#555555">NUMERIC(12,2)</font></td><td align="left"><font color="#9a6400">CHK</font></td></tr><tr><td port="warranty_expiry" align="left" bgcolor="white">warranty_expiry</td><td align="left"><font color="#555555">DATE</font></td><td align="left"><font color="#9a6400">CHK</font></td></tr><tr><td port="status" align="left" bgcolor="white">status</td><td align="left"><font color="#555555">VARCHAR(20)</font></td><td align="left"><font color="#9a6400">CHK</font></td></tr><tr><td port="specifications" align="left" bgcolor="white">specifications</td><td align="left"><font color="#555555">JSONB</font></td><td align="left"> </td></tr></table>>];
incidents [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#888888"><tr><td colspan="3" bgcolor="#1c5cab"><font color="white"><b>incidents</b></font></td></tr><tr><td port="incident_id" align="left" bgcolor="#fff3d6"><b>incident_id</b></td><td align="left"><font color="#555555">SERIAL</font></td><td align="left"><font color="#9a6400">PK</font></td></tr><tr><td port="equipment_id" align="left" bgcolor="white">equipment_id</td><td align="left"><font color="#555555">INT</font></td><td align="left"><font color="#9a6400">FK</font></td></tr><tr><td port="reported_by" align="left" bgcolor="white">reported_by</td><td align="left"><font color="#555555">INT</font></td><td align="left"><font color="#9a6400">FK</font></td></tr><tr><td port="title" align="left" bgcolor="white">title</td><td align="left"><font color="#555555">VARCHAR(150)</font></td><td align="left"> </td></tr><tr><td port="description" align="left" bgcolor="white">description</td><td align="left"><font color="#555555">TEXT</font></td><td align="left"><font color="#9a6400">CHK</font></td></tr><tr><td port="severity" align="left" bgcolor="white">severity</td><td align="left"><font color="#555555">VARCHAR(10)</font></td><td align="left"><font color="#9a6400">CHK</font></td></tr><tr><td port="status" align="left" bgcolor="white">status</td><td align="left"><font color="#555555">VARCHAR(12)</font></td><td align="left"><font color="#9a6400">CHK</font></td></tr><tr><td port="reported_at" align="left" bgcolor="white">reported_at</td><td align="left"><font color="#555555">TIMESTAMPTZ</font></td><td align="left"> </td></tr><tr><td port="resolved_at" align="left" bgcolor="white">resolved_at</td><td align="left"><font color="#555555">TIMESTAMPTZ</font></td><td align="left"> </td></tr><tr><td port="closed_at" align="left" bgcolor="white">closed_at</td><td align="left"><font color="#555555">TIMESTAMPTZ</font></td><td align="left"> </td></tr></table>>];
incident_status_log [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#888888"><tr><td colspan="3" bgcolor="#1c5cab"><font color="white"><b>incident_status_log</b></font></td></tr><tr><td port="incident_id" align="left" bgcolor="#fff3d6"><b>incident_id</b></td><td align="left"><font color="#555555">INT</font></td><td align="left"><font color="#9a6400">PK, FK</font></td></tr><tr><td port="log_seq" align="left" bgcolor="#fff3d6"><b>log_seq</b></td><td align="left"><font color="#555555">INT</font></td><td align="left"><font color="#9a6400">PK</font></td></tr><tr><td port="old_status" align="left" bgcolor="white">old_status</td><td align="left"><font color="#555555">VARCHAR(12)</font></td><td align="left"> </td></tr><tr><td port="new_status" align="left" bgcolor="white">new_status</td><td align="left"><font color="#555555">VARCHAR(12)</font></td><td align="left"> </td></tr><tr><td port="changed_by" align="left" bgcolor="white">changed_by</td><td align="left"><font color="#555555">INT</font></td><td align="left"><font color="#9a6400">FK</font></td></tr><tr><td port="changed_at" align="left" bgcolor="white">changed_at</td><td align="left"><font color="#555555">TIMESTAMPTZ</font></td><td align="left"> </td></tr><tr><td port="remarks" align="left" bgcolor="white">remarks</td><td align="left"><font color="#555555">TEXT</font></td><td align="left"> </td></tr></table>>];
assignments [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#888888"><tr><td colspan="3" bgcolor="#5b48c9"><font color="white"><b>assignments</b></font></td></tr><tr><td port="assignment_id" align="left" bgcolor="#fff3d6"><b>assignment_id</b></td><td align="left"><font color="#555555">SERIAL</font></td><td align="left"><font color="#9a6400">PK</font></td></tr><tr><td port="incident_id" align="left" bgcolor="white">incident_id</td><td align="left"><font color="#555555">INT</font></td><td align="left"><font color="#9a6400">FK</font></td></tr><tr><td port="technician_id" align="left" bgcolor="white">technician_id</td><td align="left"><font color="#555555">INT</font></td><td align="left"><font color="#9a6400">FK</font></td></tr><tr><td port="assigned_by" align="left" bgcolor="white">assigned_by</td><td align="left"><font color="#555555">INT</font></td><td align="left"><font color="#9a6400">FK</font></td></tr><tr><td port="assigned_at" align="left" bgcolor="white">assigned_at</td><td align="left"><font color="#555555">TIMESTAMPTZ</font></td><td align="left"> </td></tr><tr><td port="is_active" align="left" bgcolor="white">is_active</td><td align="left"><font color="#555555">BOOLEAN</font></td><td align="left"><font color="#9a6400">partial UQ</font></td></tr><tr><td port="notes" align="left" bgcolor="white">notes</td><td align="left"><font color="#555555">TEXT</font></td><td align="left"> </td></tr></table>>];
technician_skills [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#888888"><tr><td colspan="3" bgcolor="#5b48c9"><font color="white"><b>technician_skills</b></font></td></tr><tr><td port="technician_id" align="left" bgcolor="#fff3d6"><b>technician_id</b></td><td align="left"><font color="#555555">INT</font></td><td align="left"><font color="#9a6400">PK, FK</font></td></tr><tr><td port="category_id" align="left" bgcolor="#fff3d6"><b>category_id</b></td><td align="left"><font color="#555555">INT</font></td><td align="left"><font color="#9a6400">PK, FK</font></td></tr><tr><td port="proficiency" align="left" bgcolor="white">proficiency</td><td align="left"><font color="#555555">SMALLINT</font></td><td align="left"><font color="#9a6400">CHK</font></td></tr></table>>];
maintenance_records [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#888888"><tr><td colspan="3" bgcolor="#1c5cab"><font color="white"><b>maintenance_records</b></font></td></tr><tr><td port="record_id" align="left" bgcolor="#fff3d6"><b>record_id</b></td><td align="left"><font color="#555555">SERIAL</font></td><td align="left"><font color="#9a6400">PK</font></td></tr><tr><td port="incident_id" align="left" bgcolor="white">incident_id</td><td align="left"><font color="#555555">INT</font></td><td align="left"><font color="#9a6400">FK</font></td></tr><tr><td port="technician_id" align="left" bgcolor="white">technician_id</td><td align="left"><font color="#555555">INT</font></td><td align="left"><font color="#9a6400">FK</font></td></tr><tr><td port="diagnosis" align="left" bgcolor="white">diagnosis</td><td align="left"><font color="#555555">TEXT</font></td><td align="left"> </td></tr><tr><td port="root_cause" align="left" bgcolor="white">root_cause</td><td align="left"><font color="#555555">VARCHAR(60)</font></td><td align="left"> </td></tr><tr><td port="action_taken" align="left" bgcolor="white">action_taken</td><td align="left"><font color="#555555">TEXT</font></td><td align="left"> </td></tr><tr><td port="outcome" align="left" bgcolor="white">outcome</td><td align="left"><font color="#555555">VARCHAR(12)</font></td><td align="left"><font color="#9a6400">CHK</font></td></tr><tr><td port="started_at" align="left" bgcolor="white">started_at</td><td align="left"><font color="#555555">TIMESTAMPTZ</font></td><td align="left"> </td></tr><tr><td port="completed_at" align="left" bgcolor="white">completed_at</td><td align="left"><font color="#555555">TIMESTAMPTZ</font></td><td align="left"><font color="#9a6400">CHK</font></td></tr><tr><td port="labour_hours" align="left" bgcolor="white">labour_hours</td><td align="left"><font color="#555555">NUMERIC(8,2)</font></td><td align="left"><font color="#9a6400">GENERATED</font></td></tr></table>>];
spare_parts [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#888888"><tr><td colspan="3" bgcolor="#1c5cab"><font color="white"><b>spare_parts</b></font></td></tr><tr><td port="part_id" align="left" bgcolor="#fff3d6"><b>part_id</b></td><td align="left"><font color="#555555">SERIAL</font></td><td align="left"><font color="#9a6400">PK</font></td></tr><tr><td port="part_no" align="left" bgcolor="white">part_no</td><td align="left"><font color="#555555">VARCHAR(20)</font></td><td align="left"><font color="#9a6400">UQ</font></td></tr><tr><td port="part_name" align="left" bgcolor="white">part_name</td><td align="left"><font color="#555555">VARCHAR(80)</font></td><td align="left"> </td></tr><tr><td port="part_category" align="left" bgcolor="white">part_category</td><td align="left"><font color="#555555">VARCHAR(40)</font></td><td align="left"> </td></tr><tr><td port="unit_cost" align="left" bgcolor="white">unit_cost</td><td align="left"><font color="#555555">NUMERIC(10,2)</font></td><td align="left"><font color="#9a6400">CHK</font></td></tr><tr><td port="qty_in_stock" align="left" bgcolor="white">qty_in_stock</td><td align="left"><font color="#555555">INT</font></td><td align="left"><font color="#9a6400">CHK</font></td></tr><tr><td port="reorder_level" align="left" bgcolor="white">reorder_level</td><td align="left"><font color="#555555">INT</font></td><td align="left"><font color="#9a6400">CHK</font></td></tr></table>>];
part_usage [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#888888"><tr><td colspan="3" bgcolor="#5b48c9"><font color="white"><b>part_usage</b></font></td></tr><tr><td port="record_id" align="left" bgcolor="#fff3d6"><b>record_id</b></td><td align="left"><font color="#555555">INT</font></td><td align="left"><font color="#9a6400">PK, FK</font></td></tr><tr><td port="part_id" align="left" bgcolor="#fff3d6"><b>part_id</b></td><td align="left"><font color="#555555">INT</font></td><td align="left"><font color="#9a6400">PK, FK</font></td></tr><tr><td port="quantity" align="left" bgcolor="white">quantity</td><td align="left"><font color="#555555">INT</font></td><td align="left"><font color="#9a6400">CHK</font></td></tr><tr><td port="unit_cost_at_use" align="left" bgcolor="white">unit_cost_at_use</td><td align="left"><font color="#555555">NUMERIC(10,2)</font></td><td align="left"> </td></tr></table>>];
user_phones:user_id -> users:user_id;
labs:incharge_id -> users:user_id;
equipment_categories:parent_id -> equipment_categories:category_id;
equipment:category_id -> equipment_categories:category_id;
equipment:lab_id -> labs:lab_id;
incidents:equipment_id -> equipment:equipment_id;
incidents:reported_by -> users:user_id;
incident_status_log:incident_id -> incidents:incident_id;
incident_status_log:changed_by -> users:user_id;
assignments:incident_id -> incidents:incident_id;
assignments:technician_id -> users:user_id;
assignments:assigned_by -> users:user_id;
technician_skills:technician_id -> users:user_id;
technician_skills:category_id -> equipment_categories:category_id;
maintenance_records:incident_id -> incidents:incident_id;
maintenance_records:technician_id -> users:user_id;
part_usage:record_id -> maintenance_records:record_id;
part_usage:part_id -> spare_parts:part_id;
}