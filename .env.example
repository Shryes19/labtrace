# PostgreSQL - the app connects with the NOINHERIT login role created by sql/04_security.sql
DATABASE_URL=postgresql://labtrace_app:labtrace_app@localhost:5432/labtrace

# MongoDB knowledge base
#   docker compose up -d  -> MongoDB Atlas Local (supports $vectorSearch)
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DB=labtrace_kb
#   atlas = use $vectorSearch (Atlas / Atlas Local, after running nosql/02_vector_index.js)
#   app   = exact cosine k-NN computed in Node (works on any MongoDB)
MONGODB_VECTOR_SEARCH=app
MONGODB_VECTOR_INDEX=vector_index
#   No MongoDB at all? use a JSON-file dev store instead:
# MONGODB_URI=file:./.data/kb

# auto = MiniLM sentence-transformer if available, else offline local embeddings
EMBEDDING_PROVIDER=auto

# long random string used to sign login sessions (JWT)
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
