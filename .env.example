# PostgreSQL - the app connects with the NOINHERIT login role created by sql/04_security.sql
DATABASE_URL=postgresql://labtrace_app:labtrace_app@localhost:5433/labtrace

# MongoDB knowledge base (docker compose up -d starts MongoDB 7 on port 27017)
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_DB=labtrace_kb
#   app   = exact cosine k-NN computed in Node (works on any MongoDB - default)
#   atlas = use $vectorSearch (only on MongoDB Atlas / Atlas Local, after nosql/02_vector_index.js)
MONGODB_VECTOR_SEARCH=app
MONGODB_VECTOR_INDEX=vector_index
#   No MongoDB at all? use a JSON-file dev store instead:
# MONGODB_URI=file:./.data/kb

# local = built-in offline embeddings (light, no download)
# auto  = MiniLM sentence-transformer if @huggingface/transformers is installed, else local
EMBEDDING_PROVIDER=local

# long random string used to sign login sessions (JWT)
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
